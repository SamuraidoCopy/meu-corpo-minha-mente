# =============================================================
# Variáveis de ambiente — O Mapa da Raiz
# Crie um arquivo '.env.local' com estes valores antes de 'npm run dev'.
# Em produção, configure as mesmas vars na Vercel (Settings > Environment Variables).
# =============================================================

# --- Supabase (público — exposto ao browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Supabase (SECRETO — service role, só no servidor) ---
# Usado pelo webhook da Hotmart e pelo cron para criar/banir usuários no Auth.
# NUNCA expor no client nem commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Banco (conexão direta Postgres — migrations/tooling) ---
DATABASE_URL=postgresql://postgres:[SENHA]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Hotmart (webhook) ---
# Token "hottok" da configuração de webhook no painel da Hotmart.
# Precisa ser IDÊNTICO ao valor cadastrado lá, senão o webhook responde 401.
HOTMART_WEBHOOK_TOKEN=seu-hottok-da-hotmart

# --- Cron (Vercel) ---
# Protege /api/cron/release-access. A Vercel injeta este valor como
# 'Authorization: Bearer <CRON_SECRET>' ao chamar os crons do vercel.json.
# Sem ele, o endpoint fica chamável publicamente. Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=gere-um-valor-aleatorio-forte

# --- Site URL (opcional) ---
# Origem usada no redirect do magic link. Se ausente, usa o host da requisição.
NEXT_PUBLIC_SITE_URL=https://seu-dominio-de-producao.com

# --- Brevo (Email Marketing) ---
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_LIST_ALUNOS_ID=7

# --- Quiz publico (server-only) ---
BREVO_LIST_LEADS_ID=8
BREVO_TEMPLATE_QUIZ_MADEIRA_ID=17
BREVO_TEMPLATE_QUIZ_FOGO_ID=18
BREVO_TEMPLATE_QUIZ_TERRA_ID=19
BREVO_TEMPLATE_QUIZ_METAL_ID=20
BREVO_TEMPLATE_QUIZ_AGUA_ID=21
# Segredo aleatorio usado para gerar hashes de rate limit. Nunca o exponha ao client.
QUIZ_RATE_LIMIT_SECRET=gere-um-segredo-aleatorio-forte
